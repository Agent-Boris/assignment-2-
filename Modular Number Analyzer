
#include <iostream>
using namespace std;

int countDigits(int n) {
    if (n < 0) n = -n;
    if (n == 0) return 1;
    int count = 0;
    while (n > 0) { count++; n /= 10; }
    return count;
}

int sumDigits(int n) {
    if (n < 0) n = -n;
    int sum = 0;
    while (n > 0) { sum += n % 10; n /= 10; }
    return sum;
}

int productDigits(int n) {
    if (n < 0) n = -n;
    if (n == 0) return 0;
    int product = 1;
    while (n > 0) { product *= n % 10; n /= 10; }
    return product;
}

int reverseNumber(int n) {
    int sign = (n < 0) ? -1 : 1;
    if (n < 0) n = -n;
    int rev = 0;
    while (n > 0) { rev = rev * 10 + n % 10; n /= 10; }
    return rev * sign;
}

bool isPalindrome(int n) {
    if (n < 0) return false;
    return n == reverseNumber(n);
}

bool isPrime(int n) {
    if (n <= 1) return false;
    for (int i = 2; i * i <= n; i++)
        if (n % i == 0) return false;
    return true;
}


int main() {
    int n;
    cout << "Enter an integer: ";
    cin >> n;
    cout << "Number of digits: " << countDigits(n) << endl;
    cout << "Sum of digits: " << sumDigits(n) << endl;
    cout << "Product of digits: " << productDigits(n) << endl;
    cout << "Reverse: " << reverseNumber(n) << endl;
    cout << "Palindrome: " << (isPalindrome(n) ? "Yes" : "No") << endl;
    cout << "Prime: " << (isPrime(n) ? "Yes" : "No") << endl;
    return 0;
}
